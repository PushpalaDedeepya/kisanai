# ==============================================================================
# Kisan AI - Environment Configuration Template
# Copy this file to .env and configure your secret API keys.
# DO NOT commit the actual .env file to public Git.
# ==============================================================================

# Groq Cloud API Key for LLaMA 3.3 and Vision Models
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# (Optional) OpenWeatherMap API Key
# If not provided, Kisan AI uses live Open-Meteo weather API automatically (no key needed)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# (Optional) Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
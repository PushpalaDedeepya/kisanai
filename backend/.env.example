# ==============================================================================
# KISAN AI - ENVIRONMENT CONFIGURATION
# ==============================================================================
# NOTE: Kisan AI works out-of-the-box in offline/fallback mode with live Open-Meteo weather
# even without any external API keys! Add API keys below to enable high-end cloud LLM & Vision.

# [OPTIONAL] Groq Cloud API Key for LLaMA 3.3 70B & Vision models
# Get free API key from: https://console.groq.com
GROQ_API_KEY=

# [OPTIONAL] Google Gemini API Key for multimodal reasoning
# Get API key from: https://aistudio.google.com
GEMINI_API_KEY=

# [OPTIONAL] OpenWeatherMap API Key (Open-Meteo is used by default with zero key required)
# Get key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development